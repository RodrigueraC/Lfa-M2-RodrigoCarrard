#Options
GenerateScanner = true
GenerateParser = true
Language = Java
ScannerName = Lexico
ParserName = Sintatico
SemanticName = Semantico
Package = gals
ScannerCaseSensitive = true
ScannerTable = Compact
Input = Stream
Parser = SLR
#RegularDefinitions
L : [a-zA-Z]
D : [0-9]
#Tokens
 : [\ \n\t\r\s]+
binario : [01]+
id : {L} ({L} | {D} | _)*
Show = id : "Show"
log = id : "log"
"="
";"
"("
")"
"+"
"-"
"*"
"/"
"^"
#NonTerminals
<lista_comandos>
<comando>
<expr>
<termo>
<fator>
<base>
#Grammar
<lista_comandos> ::= <lista_comandos> <comando> | <comando> ;
<comando> ::= id #1 "=" <expr> ";" #2
            | Show "(" <expr> ")" ";" #3 ;
<expr> ::= <expr> "+" <termo> #4
         | <expr> "-" <termo> #5
         | <termo> ;
<termo> ::= <termo> "*" <fator> #6
          | <termo> "/" <fator> #7
          | <fator> ;
<fator> ::= <base> "^" <fator> #8
          | <base> ;
<base> ::= binario #9
         | id #10
         | "(" <expr> ")"
         | log "(" <expr> ")" #11 ;
